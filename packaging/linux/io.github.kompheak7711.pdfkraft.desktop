[Desktop Entry]
Type=Application
Name=PDFKraft
GenericName=PDF Editor
Comment=Read, organize, combine, split and secure PDFs
Exec=pdfkraft %U
TryExec=pdfkraft
Icon=io.github.kompheak7711.pdfkraft
Terminal=false
StartupNotify=true
StartupWMClass=io.github.kompheak7711.pdfkraft
Categories=Office;Viewer;
Keywords=pdf;viewer;editor;annotate;sign;forms;merge;split;
MimeType=application/pdf;
